---
/**
 * The hero's download console: one primary button for this computer, the
 * other platforms, and the release. Works without JS (the primary button leads
 * to the download list); src/scripts/download.ts points it at this computer's
 * build. Version and date are fixed at build time (src/data/release.ts).
 */
import { release } from '../data/release';
---

<div class="console">
  <div class="btn-row">
    <a href="#download" class="btn btn--primary btn--xl" data-dl-primary>
      <i class="fa-solid fa-arrow-down" data-dl-icon aria-hidden="true"></i><span data-dl-label>Download Siple</span>
    </a>
    <a href="#download" class="btn btn--lg console__all">All platforms</a>
  </div>
  <p class="console__status" aria-live="polite">
    <span class="lamp" data-lamp aria-hidden="true"></span>
    <span>Siple {release.version} · {release.label}</span>
  </p>
  <p class="console__note" data-dl-primary-note hidden></p>
</div>

<style>
  .console {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .console__status,
  .console__note {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--t-sm);
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
  }
  .console__note {
    margin-top: -8px;
    padding-left: 18px;
    font-size: var(--t-xs);
    color: var(--text-3);
  }
  /* On a phone the primary already goes to the download list. */
  :global(:root[data-platform='mobile']) .console__all {
    display: none;
  }
  .console__note[hidden] {
    display: none;
  }
  @media (max-width: 560px) {
    .console .btn-row > .btn {
      flex: 1 1 100%;
    }
  }
</style>
