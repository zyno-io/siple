---
/**
 * The hero's download console: one primary button for this computer, the
 * other platforms, GitHub, and the live release state. Works without JS (all
 * links go to GitHub Releases); src/scripts/release.ts upgrades it.
 */
import { site } from '../data/site';
---

<div class="console">
  <div class="btn-row">
    <a href={site.releases} class="btn btn--primary btn--xl" data-dl-primary>
      <i class="fa-solid fa-arrow-down" data-dl-icon aria-hidden="true"></i><span data-dl-label>Download Siple</span>
    </a>
    <a href="#download" class="btn btn--lg console__all">All platforms</a>
    <a href={site.repo} class="btn btn--lg btn--ghost" data-when="pending release candidate error"><i class="fa-brands fa-github" aria-hidden="true"></i>GitHub</a>
  </div>
  <p class="console__status" aria-live="polite">
    <span class="lamp" data-lamp aria-hidden="true"></span>
    <span data-dl-status-text>Builds for macOS, Windows and Linux are published on GitHub Releases.</span>
  </p>
  <p class="console__note" data-dl-primary-note hidden></p>
</div>

<style>
  .console {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .console__status,
  .console__note {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--t-sm);
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
  }
  .console__note {
    margin-top: -8px;
    padding-left: 18px;
    font-size: var(--t-xs);
    color: var(--text-3);
  }
  /* On a phone the primary already goes to the download list. */
  :global(:root[data-platform='mobile']) .console__all {
    display: none;
  }
  .console__note[hidden] {
    display: none;
  }
  @media (max-width: 560px) {
    .console .btn-row > .btn {
      flex: 1 1 100%;
    }
  }
</style>
