---
import BrandMark from './BrandMark.astro';
import { site, doc } from '../data/site';

const cols = [
  {
    title: 'Siple',
    links: [
      { label: 'Download', href: '/#download' },
      { label: 'Features', href: '/#calls' },
      { label: 'AI agents', href: '/#agents' },
      { label: 'Licence', href: '/#licence' },
    ],
  },
  {
    title: 'Docs',
    links: [
      { label: 'Install', href: doc.install },
      { label: 'First run and accounts', href: doc.firstRun },
      { label: 'AI agents', href: doc.agents },
      { label: 'Agent skill', href: doc.skill },
      { label: 'MCP quick start', href: doc.mcp },
      { label: 'Configuration reference', href: doc.configRef },
    ],
  },
  {
    title: 'Project',
    links: [
      { label: 'GitHub', href: site.repo },
      { label: 'Releases', href: site.releases },
      { label: 'Changelog', href: doc.changelog },
      { label: 'Security', href: doc.security },
      { label: site.contact, href: `mailto:${site.contact}` },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Licence (FSL-1.1-ALv2)', href: site.licenceText },
      { label: 'Privacy', href: site.privacy },
      { label: 'Terms', href: site.terms },
    ],
  },
];
---

<footer class="foot">
  <div class="wrap foot__cols">
    <div class="foot__about">
      <BrandMark />
      <p class="fine">
        The scriptable SIP softphone for macOS, Windows and Linux. Source-available under FSL-1.1-ALv2.
      </p>
    </div>
    {
      cols.map((c) => (
        <div>
          <h2 class="foot__hd">{c.title}</h2>
          <ul class="foot__list">
            {c.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="wrap foot__base">
    <span>© 2026 {site.maker}</span>
    <span>Licence questions: <a href={`mailto:${site.contact}`}>{site.contact}</a></span>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--border);
    background: var(--surface);
  }
  .foot__cols {
    display: grid;
    grid-template-columns: 1.4fr repeat(4, 1fr);
    gap: 32px;
    padding-top: 56px;
    padding-bottom: 40px;
  }
  .foot__about .fine {
    max-width: 280px;
    margin-top: 14px;
  }
  .foot__hd {
    margin-bottom: 12px;
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--text);
  }
  .foot__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .foot__list a {
    color: var(--text-2);
    font-size: var(--t-sm);
    text-decoration: none;
  }
  .foot__list a:hover {
    color: var(--text);
    text-decoration: underline;
  }
  .foot__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    position: relative;
    padding-top: 20px;
    padding-bottom: 28px;
    font-size: var(--t-xs);
    color: var(--text-3);
  }
  .foot__base a {
    color: var(--text-2);
  }
  .foot__base::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--gutter);
    right: var(--gutter);
    height: 1px;
    background: var(--border);
  }
  @media (max-width: 900px) {
    .foot__cols {
      grid-template-columns: repeat(2, 1fr);
    }
    .foot__about {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 820px) {
    .foot__list {
      gap: 0;
    }
    .foot__list a {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
    }
  }
</style>
