<!-- AppStream metadata for Flathub and the Linux tarball (share/metainfo). Add a <release> (newest first) when
     CHANGELOG.md gets the version heading; CI checks it (scripts/flatpak-check-release.sh). Screenshots are the
     visual-test goldens at a release tag. -->
<component type="desktop-application">
  <id>io.zyno.siple</id>
  <name>Siple</name>
  <summary>SIP softphone with an API for agents</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>FSL-1.1-ALv2</project_license>
  <developer id="io.zyno">
    <name>Signal24 LLC</name>
  </developer>
  <description>
    <p>Siple is a desktop SIP softphone for any standards-based PBX or SIP provider: Asterisk, FreePBX, FreeSWITCH or a
      hosted service. It handles several accounts and lines, hold, transfers and busy lamps, over TLS with SRTP.</p>
    <p>Everything Siple shows and does is also available to scripts and AI agents, through a local JSON-RPC API, the
      siple-cli command-line client and an MCP server.</p>
    <ul>
      <li>Several accounts and concurrent lines, call waiting, hold, mute and DTMF</li>
      <li>Blind and attended transfer, busy lamp field keys, directed pickup and voicemail lamps</li>
      <li>UDP, TCP and TLS with certificate pinning; SRTP; Opus, G.722 and G.711</li>
      <li>Live configuration: edit the settings file while Siple runs</li>
    </ul>
    <p>Siple is source-available under the Functional Source License 1.1; each release becomes Apache-2.0 two years
      after it is published.</p>
  </description>
  <launchable type="desktop-id">io.zyno.siple.desktop</launchable>
  <url type="homepage">https://siple.app/</url>
  <url type="bugtracker">https://github.com/zyno-io/siple/issues</url>
  <url type="help">https://zyno-io.github.io/siple/guide/quick-start</url>
  <url type="faq">https://zyno-io.github.io/siple/guide/faq</url>
  <url type="vcs-browser">https://github.com/zyno-io/siple</url>
  <url type="contribute">https://zyno-io.github.io/siple/project/contributing</url>
  <provides>
