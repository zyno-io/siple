# Rust build output and packaged releases. Keep application Cargo.lock files tracked.
target/
/dist/
*.rs.bk

# Local credentials and the PBX backup (contains credentials and private keys).
.env
.env.*
!.env.example
!.env.*.example
/tests/interop/pbx.env
/tests/interop/fs-conf.tar.gz

# Local application config and runtime state.
/config.toml
/state.toml
runtime.json
siple.lock
control.sock

# Application logs and packet captures.
logs/
*.log
*.log.*
*.pcap
*.pcapng

# Editor and operating-system files.
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
._*
Thumbs.db

# Websites (sites/docs = VitePress docs, sites/www = siple.app; sites/www/.gitignore covers the rest).
sites/docs/node_modules/
sites/docs/.vitepress/dist/
sites/docs/.vitepress/cache/
sites/docs/public/screenshots/
sites/docs/.vitepress/.temp/
__pycache__/

# Flatpak build products (scripts/flatpak-*.sh): generated from Cargo.lock, never committed.
/flatpak-work/
/packaging/flatpak/cargo-sources.json
/packaging/flatpak/THIRD-PARTY-NOTICES.html
.flatpak-builder/
