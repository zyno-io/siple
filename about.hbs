<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Siple third-party notices</title>
<style>
  body { font: 15px/1.5 system-ui, sans-serif; max-width: 52rem; margin: 2rem auto; padding: 0 1rem; color: #222; }
  pre { white-space: pre-wrap; background: #f5f5f5; padding: .75rem; border-radius: 4px; font-size: 12px; }
  h2 { margin-top: 2rem; }
  .used-by { font-size: 13px; }
</style>
</head>
<body>
<h1>Third-party notices</h1>
<p>Siple is licensed under the Functional Source License, Version 1.1, ALv2 Future License
(FSL-1.1-ALv2); see the LICENSE file. It includes the third-party components listed below, each
under its own license. The vendored fork of <code>rsipstack</code> (<code>vendor/rsipstack</code>)
remains under its upstream MIT license and keeps its own LICENSE file.</p>

<h2>Summary</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>

{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<h3>Used by</h3>
<ul class="used-by">
{{#each used_by}}
  <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
